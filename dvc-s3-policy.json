{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDvcPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::duy-lam-mlflow-20261007",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "dvc",
            "dvc/*"
          ]
        }
      }
    },
    {
      "Sid": "DvcObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::duy-lam-mlflow-20261007/dvc/*"
    }
  ]
}
